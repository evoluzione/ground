# Copy to `.env` (`cp .env.example .env`) and adjust if needed. `.env` is in .gitignore.

# URL and ports
WP_URL=http://localhost:8080
HTTP_PORT=8080
MAILPIT_PORT=8025

# Database
DB_NAME=wp_ground_3
DB_USER=wp
DB_PASSWORD=wp
DB_ROOT_PASSWORD=root
WP_TABLE_PREFIX=wp_

# Admin (fresh install only)
WP_TITLE=Ground
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=devs@evoluzione.agency

# Premium plugin licenses (leave empty to skip the plugin)
# Paste the keys as given by the ACF/WPML panels. IMPORTANT: if a key contains "$"
# (the WPML subscription key is "$P$..."), wrap it in SINGLE QUOTES: this way Compose
# does not interpolate it and the value stays identical (quotes are NOT part of the value).
ACF_PRO_KEY=
WPML_USER_ID=
WPML_SUBSCRIPTION_KEY=