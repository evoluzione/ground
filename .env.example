# Copy to `.env` (`cp .env.example .env`) and adjust if needed. `.env` is in .gitignore.

# URL and ports
WP_URL=http://localhost:8080
HTTP_PORT=8080
MAILPIT_PORT=8025

# Database
DB_NAME=wp_ground_3
DB_USER=wp
DB_PASSWORD=wp
DB_ROOT_PASSWORD=root
WP_TABLE_PREFIX=wp_

# Admin (fresh install only)
WP_TITLE=Ground
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=devs@evoluzione.agency

# Feature toggles — optional plugins per project. true/1/yes/on = on.
# A plugin installs only if its toggle is on AND (it's free OR its key is set).
ENABLE_WOOCOMMERCE=true
ENABLE_WPML=false

# Seed demo content for development (true/1/yes/on = on). When on, provisioning
# imports the theme's own fixtures (catalog products, taxonomy + ACF image, nav
# menus, static front page, ACF block demo) plus the official WordPress block and
# theme test data. Runs once, then guarded by the `ground_seed_done` option.
# Leave off for a clean install.
ENABLE_SEED=false

# Premium licenses (empty = skip). Wrap values containing "$" in SINGLE QUOTES
# (e.g. the WPML key "$P$...") so Compose doesn't interpolate them.
ACF_PRO_KEY=
WPML_USER_ID=
WPML_SUBSCRIPTION_KEY=