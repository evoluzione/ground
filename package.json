{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "ground",
	"description": "WordPress starter theme for front-end developers",
	"type": "module",
	"scripts": {
		"dev": "npm-run-all -p dev:styles dev:js dev:sync",
		"build": "npm-run-all build:js build:styles",
		"dev:styles": "npx @tailwindcss/cli -i src/css/app.css -o assets/css/ground-styles.min.css --watch --verbose",
		"build:styles": "npx @tailwindcss/cli -i src/css/app.css -o assets/css/ground-styles.min.css --minify --verbose",
		"dev:js": "vite build --watch",
		"build:js": "vite build",
		"dev:sync": "browser-sync start --proxy https://ground.develop --files 'assets/css/*.css' '**/*.php' 'assets/js/*.min.js' --no-open --watch",
		"pot:generate": "wp i18n make-pot . languages/ground.pot --slug=ground --domain=ground --exclude=node_modules,assets"
	},
	"author": {
		"name": "Fabio Quarantini",
		"url": "https://www.fabioquarantini.com"
	},
	"browserslist": [
		"defaults"
	],
	"devDependencies": {
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/cli": "^4.1.18",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"browser-sync": "^3.0.4",
		"eslint": "^9.25.1",
		"eslint-config-prettier": "^10.1.8",
		"npm-run-all": "^4.1.5",
		"prettier": "3.8.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"tailwindcss": "^4.1.18",
		"tailwindcss-debug-screens": "^3.0.1",
		"vite": "7.3.1"
	},
	"dependencies": {
		"@fabioquarantini/js-utils": "^1.0.1",
		"deepmerge": "4.3.1",
		"gsap": "3.14.2",
		"photoswipe": "5.4.4",
		"swiper": "12.1.1"
	}
}
