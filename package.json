{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "ground",
	"description": "WordPress starter theme for front-end developers",
	"type": "module",
	"scripts": {
		"dev": "npm-run-all -p dev:styles dev:js dev:sync",
		"build": "npm-run-all -p build:js build:styles",
		"lint": "eslint src/js",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"dev:styles": "npx @tailwindcss/cli -i src/css/app.css -o assets/css/ground-styles.min.css --watch --verbose",
		"build:styles": "npx @tailwindcss/cli -i src/css/app.css -o assets/css/ground-styles.min.css --minify --verbose",
		"dev:js": "vite build --watch",
		"build:js": "vite build",
		"dev:sync": "browser-sync start --proxy http://localhost:8080 --files 'assets/css/*.css' '**/*.php' 'assets/js/*.min.js' --no-open --watch",
		"pot:generate": "wp i18n make-pot . languages/ground.pot --slug=ground --domain=ground --exclude=node_modules,assets",
		"docker:up": "test -f .env || cp .env.example .env; docker compose up -d --build && npm run docker:provision",
		"docker:provision": "docker compose run --rm wpcli sh /docker-scripts/provision.sh",
		"docker:down": "docker compose down",
		"docker:restart": "docker compose restart",
		"docker:reset": "docker compose down -v",
		"docker:shell": "docker compose exec wordpress bash",
		"docker:logs": "docker compose logs -f wordpress",
		"docker:ps": "docker compose ps",
		"docker:wp": "docker compose run --rm wpcli wp",
		"docker:db-import": "docker compose exec -T db sh -c 'exec mariadb -uroot -p\"$MARIADB_ROOT_PASSWORD\" \"$MARIADB_DATABASE\"'"
	},
	"author": {
		"name": "Fabio Quarantini",
		"url": "https://www.fabioquarantini.com"
	},
	"browserslist": [
		"defaults"
	],
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/cli": "^4.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"browser-sync": "^3.0.4",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.4.0",
		"npm-run-all": "^4.1.5",
		"prettier": "3.8.4",
		"tailwindcss": "^4.3.1",
		"tailwindcss-debug-screens": "^3.0.1",
		"vite": "8.0.16"
	},
	"dependencies": {
		"@fabioquarantini/js-utils": "^1.0.1",
		"deepmerge": "4.3.1",
		"gsap": "3.15.0",
		"photoswipe": "5.4.4",
		"swiper": "12.2.0"
	}
}
