{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "ground",
	"description": "WordPress starter theme for front-end developers",
	"type": "module",
	"scripts": {
		"dev": "npm-run-all -p \"styles -- --watch\" \"js -- --watch\" sync",
		"build": "npm-run-all js \"styles -- --minify\"",
		"styles": "npx @tailwindcss/cli -i src/css/app.css -o assets/css/ground-styles.min.css --verbose",
		"sync": "browser-sync start --no-open -p https://ground.develop -f 'assets/css/*.css' '**/*.php' 'assets/js/ground-scripts.min.js' -w",
		"js": "vite build",
		"pot": "wp i18n make-pot . languages/ground.pot --slug=ground --domain=ground --exclude=node_modules,assets"
	},
	"author": {
		"name": "Fabio Quarantini",
		"url": "https://www.fabioquarantini.com"
	},
	"browserslist": [
		"defaults"
	],
	"devDependencies": {
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/cli": "^4.0.9",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"browser-sync": "^3.0.3",
		"eslint": "^9.21.0",
		"eslint-config-prettier": "^10.0.2",
		"npm-run-all": "^4.1.5",
		"prettier": "3.5.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"tailwindcss": "^4.0.9",
		"vite": "6.2.0"
	},
	"dependencies": {
		"@fabioquarantini/js-utils": "^1.0.1",
		"deepmerge": "4.3.1",
		"gsap": "npm:@gsap/shockingly@^3.12.7",
		"photoswipe": "5.4.4",
		"swiper": "11.2.5"
	}
}
